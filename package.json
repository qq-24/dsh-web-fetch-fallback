{
  "name": "dsh-web-fetch-fallback",
  "version": "1.0.0",
  "description": "Transparent local-fetch fallback for DeepSeek Harness: when the configured web_fetch provider fails, fetch the URL directly and return a successful result to the same tool.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.mjs && node --check lib/config.mjs && node --check lib/local-fetch.mjs && node --check lib/should-fallback.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-fetch",
    "fallback",
    "fetch-provider",
    "resilience"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq-24/dsh-web-fetch-fallback.git"
  },
  "homepage": "https://github.com/qq-24/dsh-web-fetch-fallback",
  "bugs": {
    "url": "https://github.com/qq-24/dsh-web-fetch-fallback/issues"
  }
}
